{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "web:dev": "npm run dev --workspace @forge/web",
    "web:build": "npm run build --workspace @forge/web"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}